#!/bin/bash
# Managed by Ansible. Runs on every controller that has Wi-Fi. Idempotent (systemctl restart lab-gateway).
# Only the VRRP master receives the traffic, but the rules are identical everywhere so any node can take over.
#   - Internet for VLAN 50 (nodes) and VLAN 60 (VM floating-IP network, via br-ex)
#   - lets an admin laptop reach VLAN 40 (APIs, Horizon) and VLAN 60 (floating IPs)
WIFI={{ wifi_if }}

ensure() {   # ensure <table> <chain> <rule...>  : add at top of chain if missing
  local t=$1 c=$2; shift 2
  iptables -t "$t" -C "$c" "$@" 2>/dev/null || iptables -t "$t" -I "$c" 1 "$@"
}

sysctl -qw net.ipv4.ip_forward=1

ensure nat POSTROUTING -s {{ net.egress }}.0/24 -o "$WIFI" -j MASQUERADE
ensure nat POSTROUTING -s {{ provider_cidr }}   -o "$WIFI" -j MASQUERADE
for IN in egress br-ex; do
  ensure filter FORWARD -i "$IN" -o "$WIFI" -j ACCEPT
  ensure filter FORWARD -i "$WIFI" -o "$IN" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
done

for A in {{ [wifi_if, nic] | join(' ') }}; do
  for OUT in api br-ex; do
    ensure filter FORWARD -i "$A" -o "$OUT" -j ACCEPT
    ensure filter FORWARD -i "$OUT" -o "$A" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  done
done
ensure nat POSTROUTING -o api   -j MASQUERADE
ensure nat POSTROUTING -o br-ex -j MASQUERADE
