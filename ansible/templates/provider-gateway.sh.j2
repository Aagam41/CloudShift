#!/bin/bash
# Keeps the provider-network gateway address ({{ provider_gateway }}) on br-ex iff this node is the VRRP master.
# br-ex only exists after Kolla's deploy, and can be recreated by a reconfigure, so this reconciles every 10 s.
apply() {
  local state have
  state=$(cat /run/lab-gateway-state 2>/dev/null || echo BACKUP)
  ip link show br-ex >/dev/null 2>&1 || return 0
  have=$(ip -4 addr show dev br-ex | grep -c " {{ provider_gateway }}/")
  if [ "$state" = MASTER ] && [ "$have" = 0 ]; then
    ip addr add {{ provider_gateway }}/24 dev br-ex
    ip link set br-ex up
    arping -U -I br-ex -c 3 {{ provider_gateway }} >/dev/null 2>&1 || true   # tell the switch where the address moved
  elif [ "$state" != MASTER ] && [ "$have" != 0 ]; then
    ip addr del {{ provider_gateway }}/24 dev br-ex
  fi
}
if [ "$1" = once ]; then apply; exit 0; fi
while true; do apply; sleep 10; done
