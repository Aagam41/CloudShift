  {
   "type": "timeseries",
   "title": "Storage VLAN (GlusterFS) throughput per node",
   "description": "VM disk traffic: every write goes to all 3 controllers, so a compute node sends 3x what its VMs write",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device=\"storage\"}[5m]) + rate(node_network_transmit_bytes_total{device=\"storage\"}[5m])) * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
