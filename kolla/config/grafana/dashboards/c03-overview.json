  {
   "type": "timeseries",
   "title": "Traffic per VLAN: received",
   "description": "mgmt=API/RabbitMQ/DB, storage=GlusterFS (VM disks), tunnel=tenant VXLAN, egress=Internet, provider=floating IPs",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (device) (rate(node_network_receive_bytes_total{device=~\"mgmt|storage|tunnel|api|egress|provider|dns\"}[5m]))",
     "legendFormat": "{{device}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
