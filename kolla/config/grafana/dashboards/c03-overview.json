    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "count(node_uname_info)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
