{
 "uid": "c03-overview",
 "title": "Cloud03 / Cluster overview",
 "tags": [
  "cloud03",
  "hosts"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "graphTooltip": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "hide": 0,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Nodes reporting",
   "description": "",
