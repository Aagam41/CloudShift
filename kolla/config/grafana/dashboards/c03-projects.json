  },
  {
   "type": "timeseries",
   "title": "CPU cores in use",
   "description": "Sum over the project's VMs, 1.0 = one vCPU fully busy",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (project) (sum by (domain) (rate(libvirt_domain_info_cpu_time_seconds_total[5m])) * on(domain) group_left(project) cloud_vm_info{project=~\"$project\"})",
     "legendFormat": "{{project}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 10,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "CPU efficiency: used / allocated vCPUs %",
   "description": "Low values = the project pays for vCPUs it does not use",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "100 * sum by (project) (sum by (domain) (rate(libvirt_domain_info_cpu_time_seconds_total[5m])) * on(domain) group_left(project) cloud_vm_info{project=~\"$project\"}) / on(project) (cloud_project_vcpus{project=~\"$project\"} > 0)",
     "legendFormat": "{{project}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 11,
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   }
