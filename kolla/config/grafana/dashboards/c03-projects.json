{
 "uid": "c03-projects",
 "title": "Cloud03 / Projects and usage",
 "tags": [
  "cloud03",
  "usage"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "graphTooltip": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "hide": 0,
    "current": {}
   },
   {
    "name": "project",
    "label": "Project",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(cloud_vm_info, project)",
     "refId": "v_project"
    },
    "definition": "label_values(cloud_vm_info, project)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Projects with VMs",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "count(cloud_project_instances{project=~\"$project\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
