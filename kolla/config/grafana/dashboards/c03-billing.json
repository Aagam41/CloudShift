{
 "uid": "c03-billing",
 "title": "Cloud03 / Billing (CloudKitty)",
 "tags": [
  "cloud03",
  "billing"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "graphTooltip": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "hide": 0,
    "current": {}
   },
   {
    "name": "project",
    "label": "Project",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(cloud_billing_cost, project)",
     "refId": "v_project"
    },
    "definition": "label_values(cloud_billing_cost, project)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Cost this month",
   "description": "Rating units, see openstack/02-billing-rates.sh. Month-to-date.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(cloud_billing_cost{project=~\"$project\"}) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Cost last 24 h",
   "description": "Wrong around the 1st of the month (the total resets)",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(cloud_billing_cost{project=~\"$project\"}[24h])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "id": 2,
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Billed projects",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "count(count by (project) (cloud_billing_cost{project=~\"$project\"})) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "id": 3,
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 4
   }
  },
  {
   "type": "bargauge",
   "title": "Cost this month by project",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (project) (cloud_billing_cost{project=~\"$project\"})",
     "legendFormat": "{{project}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "continuous-GrYlRd"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   },
   "id": 4,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "piechart",
   "title": "Cost this month by service",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (service) (cloud_billing_cost{project=~\"$project\"})",
     "legendFormat": "{{service}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value"
     ]
    }
   },
   "id": 5,
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "piechart",
   "title": "Billed quantity this month by service",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (service) (cloud_billing_quantity{project=~\"$project\"})",
     "legendFormat": "{{service}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value"
     ]
    }
   },
   "id": 6,
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Month-to-date cost over time",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (project) (cloud_billing_cost{project=~\"$project\"})",
     "legendFormat": "{{project}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Cost per day",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (project) (increase(cloud_billing_cost{project=~\"$project\"}[1d]))",
     "legendFormat": "{{project}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "table",
   "title": "Project x service",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "cloud_billing_cost{project=~\"$project\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "project": "Project",
       "service": "Service",
       "Value": "Cost"
      }
     }
    }
   ],
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 10
   }
  },
  {
   "type": "text",
   "title": "",
   "options": {
    "mode": "markdown",
    "content": "**Empty?** Billing data appears after CloudKitty's first full collection period (about an hour after the first VM runs) and needs the rating rules from `openstack/02-billing-rates.sh`. Check `journalctl -u cloud-exporter` if `cloud_exporter_errors_total{source=\"billing\"}` keeps rising."
   },
   "id": 10,
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 3
   }
  }
 ]
}