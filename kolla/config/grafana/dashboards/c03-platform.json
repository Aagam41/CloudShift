  },
  {
   "type": "table",
   "title": "Scrape targets",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "up",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Value"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "DOWN",
            "color": "red"
           },
           "1": {
            "text": "UP",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true
      },
      "renameByName": {
       "Value": "State"
      }
     }
    }
   ],
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 12
   }
  },
  {
   "type": "table",
