     "expr": "topk(10, 100 * sum by (domain) (rate(libvirt_domain_info_cpu_time_seconds_total[5m])) / on(domain) group_left(name, project, host) cloud_vm_vcpus{project=~\"$project\",host=~\"$host\"})",
