  {
   "type": "timeseries",
   "title": "CPU cores in use",
   "description": "1.0 = one full vCPU busy",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "topk(10, sum by (domain) (rate(libvirt_domain_info_cpu_time_seconds_total[5m])) * on(domain) group_left(name, project, host) cloud_vm_info{project=~\"$project\",host=~\"$host\"})",
     "legendFormat": "{{name}} ({{project}})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
