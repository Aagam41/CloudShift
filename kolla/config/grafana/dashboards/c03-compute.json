{
 "uid": "c03-compute",
 "title": "Cloud03 / Compute and VMs",
 "tags": [
  "cloud03",
  "vms"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "graphTooltip": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "hide": 0,
    "current": {}
   },
   {
    "name": "project",
    "label": "Project",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(cloud_vm_info, project)",
     "refId": "v_project"
    },
    "definition": "label_values(cloud_vm_info, project)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "host",
    "label": "Host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(cloud_vm_info, host)",
     "refId": "v_host"
    },
    "definition": "label_values(cloud_vm_info, host)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
